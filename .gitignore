# Server side excludes
**/.venv/
**/__pycache__/
server/data/
**/.env
.secrets/
**/node_modules

# Client side excludes
**/.vite/

# Generated protobuf Python files (regenerate with proto/generate_proto.sh)
proto/__init__.py
proto/*_pb2.py
proto/*_pb2_grpc.py

# Log and savedata files
recordings
recordings/
server/segmentation/models/
server/motioncap/models/
logs/

# Agent Excludes
**/.claude
