// Copy this file to Credentials.xcconfig and fill in the iOS values.
// These are not the Android google-services.json values.
// They must come from your iOS OAuth client configuration.

GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID = YOUR_SERVER_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID
