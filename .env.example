# LLM API keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub Personal Access Token
GITHUB_PAT=

# Remote runner. Keep the loopback endpoint when the runner and UX share a
# machine; use an HTTPS public hostname or IP for a remote runner.
RUNNER_ENDPOINT=http://127.0.0.1:8787
RUNNER_TOKEN=
# Sample at roughly this rate before applying the runner's 32-image ceiling.
GEMMA_VIDEO_SAMPLE_FPS=4
GEMMA_VIDEO_MAX_FRAMES=32
# Required by server/runner/setup_remote.sh to download the gated checkpoint.
HF_TOKEN=

# Legacy direct VGGT service settings. RUNNER_* takes precedence.
# Set RUNNER_USE_LEGACY_VGGT=1 only to bypass the runner during migration.
VGGT_API_TOKEN=
VGGT_ENDPOINT=
VGGT_CKPT=
VGGT_MODEL_ID=facebook/VGGT-Omega
VGGT_MODEL_FILENAME=vggt_omega_1b_512.pt
RUNNER_USE_LEGACY_VGGT=0

# Robocar LAN adapter. These override the first devices.robots entry in
# server/streamlog/config.yaml. For several robots, set ROBOCAR_DEVICES to a
# JSON array of profiles with id, name, controller_url, camera_url, and optional
# camera_stream_url.
ROBOCAR_ID=robocar-1
ROBOCAR_NAME=Robocar 1
ROBOCAR_CONTROLLER_URL=http://192.168.4.1
ROBOCAR_CAMERA_URL=http://192.168.4.2
ROBOCAR_CAMERA_STREAM_URL=http://192.168.4.2:81/stream
# ROBOCAR_DEVICES=[{"id":"robocar-1","name":"Workshop car","controller_url":"http://192.168.1.31","camera_url":"http://192.168.1.32"},{"id":"robocar-2","name":"Track car","controller_url":"http://192.168.1.41","camera_url":"http://192.168.1.42"}]
