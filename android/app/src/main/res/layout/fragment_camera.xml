<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment lays over the full-screen GLSurfaceView.
     Top 75%: transparent camera viewport with chrome overlays.
     Bottom 25%: compact transcription/send controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">

        <!-- ── Top half: camera viewport ─────────────────────────────────── -->
        <!-- Background is transparent so GL shows through the center.
             Dark strips on left/right/top create the 16dp padding effect,
             matching the Figma's px-4 pt-4 bg-gray-800 container. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="@android:color/transparent">

            <!-- Left padding strip (blocks GL on the left edge) -->
            <View
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/bg_panel"
                android:clickable="false" />

            <!-- Right padding strip -->
            <View
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@color/bg_panel"
                android:clickable="false" />

            <!-- Top padding strip -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_gravity="top"
                android:background="@color/bg_panel"
                android:clickable="false" />

            <!-- LIVE / REC badge — positioned inside the camera viewport (past the 16dp strips) -->
            <TextView
                android:id="@+id/live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginTop="32dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/badge_live"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="● REC"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Recording elapsed time — bottom-left inside viewport (kept away from fullscreen btn) -->
            <TextView
                android:id="@+id/recording_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/badge_timer"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Fullscreen toggle button — small translucent circle, bottom-right corner.
                 Shows ic_fullscreen (expand) normally; ic_fullscreen_exit (collapse) when fullscreen. -->
            <ImageButton
                android:id="@+id/fullscreen_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/fullscreen_button_bg"
                android:src="@drawable/ic_fullscreen"
                android:scaleType="center"
                android:padding="6dp"
                android:contentDescription="Toggle fullscreen" />
        </FrameLayout>

        <!-- ── Bottom controls ────────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/chat_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_panel"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingTop="48dp">

                <LinearLayout
                    android:id="@+id/transcript_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/mic_button"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/mic_button_background"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/text_primary"
                        android:contentDescription="Voice recording" />

                    <TextView
                        android:id="@+id/message_label"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/transcript_label_background"
                        android:ellipsize="start"
                        android:gravity="center_vertical|start"
                        android:maxLines="2"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/camera_transcript_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/send_button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/send_button_background"
                        android:padding="14dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_send"
                        android:tint="@color/text_primary"
                        android:contentDescription="Send message"
                        android:enabled="false"
                        android:alpha="0.4" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/record_button"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-40dp"
                android:background="@drawable/record_button_idle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Record"
                android:elevation="8dp"
                android:stateListAnimator="@animator/record_button_press" />

            <ImageButton
                android:id="@+id/delete_recording_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-28dp"
                android:translationX="76dp"
                android:background="@drawable/delete_recording_button_background"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                android:tint="@color/text_primary"
                android:contentDescription="Discard recording"
                android:elevation="8dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
