<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_panel"
    android:orientation="vertical">

    <!-- ── Sticky topbar ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_chevron_left"
            android:scaleType="center"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="2dp">

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/topbar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/topbar_tags_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- thin separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ── Scrollable body + floating input bar ───────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ScrollView: tabs + video + controls + summary all scroll together -->
        <ScrollView
            android:id="@+id/summary_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="88dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ── Video player: tabs + frame + controls ────────────── -->

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/video_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@color/bg_header"
                    app:tabTextColor="@color/text_secondary"
                    app:tabSelectedTextColor="@color/text_primary"
                    app:tabIndicatorColor="@color/text_primary"
                    app:tabIndicatorHeight="2dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabTextAppearance="@android:style/TextAppearance.Small">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Understanding" />

                </com.google.android.material.tabs.TabLayout>

                <FrameLayout
                    android:id="@+id/video_container"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@color/bg_dark">

                    <ImageView
                        android:id="@+id/video_frame_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="Video frame" />

                    <TextView
                        android:id="@+id/video_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Loading video…"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="visible" />

                </FrameLayout>

                <!-- Playback controls -->
                <LinearLayout
                    android:id="@+id/video_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_header"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageButton
                        android:id="@+id/play_pause_button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:src="@android:drawable/ic_media_play"
                        android:scaleType="fitCenter"
                        android:contentDescription="Play / Pause" />

                    <SeekBar
                        android:id="@+id/video_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/text_primary"
                        android:thumbTint="@color/text_primary" />

                    <TextView
                        android:id="@+id/video_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <!-- thin separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bg_dark" />

                <!-- ── Summary text ──────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/summary_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/summary_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.5"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/summary_loading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading analysis…"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:paddingTop="24dp"
                        android:gravity="center"
                        android:visibility="visible" />

                </LinearLayout>

                <!-- ── Chat messages ────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/chat_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- ── Floating input bar ─────────────────────────────────────────── -->
        <!-- No background; scrim gradient creates the frosted-glass illusion  -->
        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <!-- Gradient scrim: transparent at top → ~90 % bg_panel at bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bar_scrim" />

            <!-- Input pill: EditText + send button sit inside the same rounded container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_background"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <EditText
                    android:id="@+id/message_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Message…"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <ProgressBar
                    android:id="@+id/send_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:visibility="visible" />

                <ImageButton
                    android:id="@+id/send_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_send"
                    android:scaleType="fitCenter"
                    android:contentDescription="Send"
                    android:enabled="false"
                    android:alpha="0.35"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
